{
  "id": "team",
  "voice": "am_michael",
  "speed": 1.05,
  "scenes": [
    {
      "id": "hello",
      "minSeconds": 9.0,
      "lines": [
        {
          "id": "team-hello",
          "at": 0.6,
          "text": "This is Boris, a UC Berkeley freshman who likes working at the frontier of technology. He previously worked at Lockheed Martin's solar lab."
        }
      ]
    },
    {
      "id": "why",
      "minSeconds": 8.0,
      "lines": [
        {
          "id": "team-why",
          "at": 0.3,
          "text": "For this hackathon he didn't want a demo. He wanted a lab, where agents come up with an idea, test it against a scorer they can't touch, and argue about whether it's real."
        }
      ]
    },
    {
      "id": "team",
      "minSeconds": 4.0,
      "lines": [
        {
          "id": "team-team",
          "at": 0.3,
          "text": "A research team used to mean a room full of people. This one is one student and seven agents."
        }
      ]
    },
    {
      "id": "roster",
      "minSeconds": 18.0,
      "lines": [
        {
          "id": "team-pi",
          "at": 0.4,
          "voice": "bm_george",
          "text": "I'm the [PI](/pˌiˈI/). I decide what we test."
        },
        {
          "id": "team-literature",
          "at": 0.25,
          "after": "team-pi",
          "voice": "af_heart",
          "text": "I find the papers."
        },
        {
          "id": "team-analyst",
          "at": 0.25,
          "after": "team-literature",
          "voice": "am_puck",
          "text": "I work out why we missed."
        },
        {
          "id": "team-engineer",
          "at": 0.25,
          "after": "team-analyst",
          "voice": "am_fenrir",
          "text": "I build each idea, and there are usually three of me."
        },
        {
          "id": "team-skeptic",
          "at": 0.25,
          "after": "team-engineer",
          "voice": "bf_emma",
          "text": "I decide whether a gain is real."
        },
        {
          "id": "team-evaluator",
          "at": 0.25,
          "after": "team-skeptic",
          "voice": "am_michael",
          "text": "I run the final test on planets we've never seen, and only when a human says go."
        },
        {
          "id": "team-vetter",
          "at": 0.25,
          "after": "team-evaluator",
          "voice": "af_bella",
          "text": "I check new signals before anyone gets excited."
        }
      ]
    },
    {
      "id": "close",
      "minSeconds": 6.0,
      "lines": [
        {
          "id": "team-close",
          "at": 0.4,
          "text": "Together, they are Planet lab."
        }
      ]
    }
  ],
