        {
          "id": "demo-transit",
          "at": 0.8,
          "text": "When a planet crosses its star, the starlight dips, just a little."
        }
      ]
    },
    {
      "id": "survey",
      "minSeconds": 6.0,
      "lines": [
        {
          "id": "demo-survey",
          "at": 0.2,
          "text": "Tess watches hundreds of thousands of stars, and has already found an Earth-size planet in its star's habitable zone."
        }
      ]
    },
    {
      "id": "problem",
      "minSeconds": 7.0,
      "lines": [
        {
          "id": "demo-problem",
          "at": 0.2,
          "text": "But small planets make the faintest dips, and our starting search found just {baselineFaint} of {faintTotal}. Each fix took an expert about a day."
        }
      ]
    },
    {
      "id": "title",
      "minSeconds": 3.5,
      "lines": [
        {
          "id": "demo-title",
          "at": 0.4,
          "text": "Planet lab hands that work to seven AI agents."
        }
      ]
    },
    {
      "id": "loop",
      "minSeconds": 6.0,
      "lines": [
        {
          "id": "demo-loop",
          "at": 0.2,
          "text": "They read papers, study the misses, build fixes in parallel, and check every gain."
        }
      ]
    },
    {
      "id": "grading",
      "minSeconds": 4.2,
      "lines": [
        {
          "id": "demo-grading",
          "at": 0.2,
          "text": "Each idea is graded on how many of {devPlanets} known planets it finds."
        }
      ]
    },
    {
      "id": "result",
      "minSeconds": 6.6,
      "lines": [
        {
          "id": "demo-result",
          "at": 0.2,
          "text": "In one night they tested seven ideas and raised the count from {baselinePlanets} to {championPlanets}."
        }
      ]
    },
    {
      "id": "discovery",
      "minSeconds": 5.0,
      "lines": [
        {
          "id": "demo-discovery",
          "at": 0.2,
          "text": "{discoveryLine}"
