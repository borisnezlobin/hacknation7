      "minSeconds": 8.0,
      "lines": [
        {
          "id": "demo-ending",
          "at": 0.3,
          "text": "Better searches mean more worlds to study, maybe habitable ones. And a lab that needed a building now fits in a dorm room, ready for any science you can score, from planets to medicine."
        }
      ]
